# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# PRICING_SERVICE_BASE_URL: Base URL of the Marco Pricing Service (services/pricing).
# Left empty by default on purpose: with no pricing service configured, LivePricingRepository
# reports quotes as unavailable rather than fabricating a target (see ARCHITECTURE.md section 9).
# - Local development against the Android emulator: http://10.0.2.2:8085
# - A physical device on the same network, or a deployed instance: use an https:// URL.
#   Cleartext http:// should only ever be used for a developer's own local/emulator override.
PRICING_SERVICE_BASE_URL="\"\""
